{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "katarsis",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./web", "binding": "ASSETS",
    "run_worker_first": true, "html_handling": "none", "not_found_handling": "none"
  },
  "observability": {"enabled": false}
}
